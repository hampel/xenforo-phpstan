<?php

/**
 * XenForo's schema builder documents the index name of addKey(), addUniqueKey() and
 * addFullTextKey() as `@param null $indexName`, and every Setup.php passes a string. PHPStan
 * takes the docblock literally and reports each call at level 5. These restate the three
 * methods with the type they accept; a stub replaces only the PHPDoc of the methods it names.
 *
 * addColumn() is restated too, with the return type XenForo leaves undeclared: a class can be
 * declared in one stub file only, so every correction to AbstractDdl lives here.
 *
 * Index and Column are declared here as well, because PHPStan checks a stub against the
 * classes it can autoload or the stub declares - not against the scanned forum - and would
 * otherwise report the return types as unknown. Index is empty, which adds nothing to the real
 * class; Column carries its fluent setters, since a class may be declared in one stub file only.
 */

namespace XF\Db\Schema;

class Index
{
}

class Column
{
    /**
     * The fluent setters return $this, undeclared, so a chain such as
     * addColumn()->type()->nullable() lost the column after the first call at level 7 and above.
     * drop() returns nothing and is left alone.
     *
     * @param mixed $renameTo
     *
     * @return static
     */
    public function renameTo($renameTo) {}

    /**
     * @param mixed $type
     * @param mixed $length
     *
     * @return static
     */
    public function type($type, $length = null) {}

    /**
     * @param mixed $length
     *
     * @return static
     */
    public function length($length) {}

    /**
     * @param mixed $values
     *
     * @return static
     */
    public function values($values) {}

    /**
     * @param mixed $values
     *
     * @return static
     */
    public function addValues($values) {}

    /**
     * @param mixed $values
     *
     * @return static
     */
    public function removeValues($values) {}

    /**
     * @param mixed $unsigned
     *
     * @return static
     */
    public function unsigned($unsigned = null) {}

    /**
     * @param mixed $nullable
     *
     * @return static
     */
    public function nullable($nullable = null) {}

    /**
     * @param mixed $default
     *
     * @return static
     */
    public function setDefault($default) {}

    /**
     * @param mixed $autoIncrement
     * @param mixed $setAsPrimary
     *
     * @return static
     */
    public function autoIncrement($autoIncrement = null, $setAsPrimary = true) {}

    /**
     * @return static
     */
    public function primaryKey() {}

    /**
     * @param mixed $comment
     *
     * @return static
     */
    public function comment($comment) {}

    /**
     * @param mixed $after
     *
     * @return static
     */
    public function after($after) {}

    /**
     * @return static
     */
    public function resetDefinition() {}
}

abstract class AbstractDdl
{
    /**
     * @param mixed $columnName
     * @param mixed $type
     * @param mixed $length
     *
     * @return Column
     */
    public function addColumn($columnName, $type = null, $length = null) {}

    /**
     * @param string|string[] $column
     * @param string|null $indexName
     * @return Index
     */
    public function addUniqueKey($column, $indexName = null) {}

    /**
     * @param string|string[] $column
     * @param string|null $indexName
     * @return Index
     */
    public function addKey($column, $indexName = null) {}

    /**
     * @param string|string[] $column
     * @param string|null $indexName
     * @return Index
     */
    public function addFullTextKey($column, $indexName = null) {}
}
