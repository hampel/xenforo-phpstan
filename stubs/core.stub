<?php

/**
 * Return types XenForo 2.3 leaves undeclared on methods every add-on calls, read from the
 * method bodies of 2.3.13. Each is the type the method returns on every path; a method whose
 * result depends on the forum's data, such as a database fetch, is left as it is. The
 * parameters are `mixed` except where XenForo's own docblock types them, because a parameter
 * type is a new claim about every caller - an add-on passing a route parameter to redirect()
 * would be reported by a stub that set out to type what comes back - and they are declared at
 * all because PHPStan checks a stub with the consumer's own level, where an untyped parameter
 * is itself a report.
 *
 * A stub replaces only the PHPDoc of the members it names, so a signature here must match the
 * real one. A class declared here empty adds nothing to the real class: it is declared because
 * PHPStan checks a stub against the classes it can autoload or the stub declares, not against
 * the scanned forum. A class may be declared in one stub file only, which is why addColumn()
 * is in db-schema.stub with the rest of AbstractDdl.
 */

namespace {

    class XF
    {
        /**
         * @param mixed $name
         * @param array<mixed> $params
         * @param mixed $allowHtml
         *
         * @return \XF\Phrase
         */
        public static function phrase($name, array $params = [], $allowHtml = true) {}
    }
}

namespace XF {

    class ContinuationResult
    {
        /**
         * @return self
         */
        public static function completed() {}
    }

    class Phrase
    {
    }

    /**
     * Records keyed by id, each holding its parent's id under one offset. The record type is
     * whatever was given, usually a node entity through NodeRepository::createNodeTree(), and
     * XenForo's own trees of navigation, template and style arrays. Reading an offset gives the
     * subtree at that id; iterating gives the root's children. The constructor parameter is typed,
     * the one place a stub here claims a parameter: the template binds nowhere else, and the body
     * iterates the argument on its first line, so nothing that runs is refused.
     *
     * @template TRecord
     * @implements \ArrayAccess<int|string, SubTree<TRecord>|null>
     * @implements \IteratorAggregate<int|string, SubTree<TRecord>>
     */
    class Tree implements \ArrayAccess, \IteratorAggregate, \Countable
    {
        /**
         * @param iterable<int|string, TRecord> $data
         * @param mixed $parentIdKey
         * @param mixed $root
         */
        public function __construct($data, $parentIdKey = 'parent_id', $root = 0) {}

        /**
         * @param mixed $id
         *
         * @return array<int|string, SubTree<TRecord>>
         */
        public function children($id = null) {}

        /**
         * @param mixed $id
         *
         * @return array<int|string, int|string>
         */
        public function childIds($id = null) {}

        /**
         * @param mixed $id
         *
         * @return int
         */
        public function countChildren($id = null) {}

        /**
         * @param mixed $id
         *
         * @return TRecord|null
         */
        public function getData($id) {}

        /**
         * @return iterable<int|string, TRecord>
         */
        public function getAllData() {}

        /**
         * @return int|string
         */
        public function getRoot() {}

        /**
         * @return array<int|string, array<int|string, int|string>>
         */
        public function getParentMap() {}

        /**
         * @return array<int|string, list<int|string>>
         */
        public function getParentMapSimplified() {}

        /**
         * @param mixed $id
         *
         * @return SubTree<TRecord>|null
         */
        public function parent($id) {}

        /**
         * Top-down, keyed by id; null for an id the tree does not hold.
         *
         * @param mixed $id
         * @param mixed $withSelf
         *
         * @return array<int|string, TRecord>|null
         */
        public function getPathTo($id, $withSelf = false) {}

        /**
         * @param mixed $id
         * @param mixed $newParentId
         *
         * @return bool
         */
        public function isNewParentValid($id, $newParentId) {}

        /**
         * @param mixed $depth
         * @param mixed $rootId
         *
         * @return array<int|string, array{record: TRecord, depth: int}>
         */
        public function getFlattened($depth = 0, $rootId = null) {}

        /**
         * @param mixed $rootId
         *
         * @return array<int|string, TRecord>
         */
        public function getDescendants($rootId = null) {}

        /**
         * The callbacks stay as XenForo declares them, a Closure: typing their parameters would
         * report every callback declared narrower than int|string for the id.
         *
         * @param mixed $depth
         * @param mixed $rootId
         *
         * @return void
         */
        public function traverse(\Closure $callback, $depth = 0, $rootId = null) {}

        /**
         * @return Tree<TRecord>
         */
        public function filter(?\Closure $preOrder = null, ?\Closure $postOrder = null) {}

        /**
         * What was given, less every record the traversal reached.
         *
         * @return iterable<int|string, TRecord>
         */
        public function getOrphans() {}

        /**
         * Restated, as for AbstractCollection: a stubbed class loses the real docblock here.
         *
         * @return \ArrayIterator<int|string, SubTree<TRecord>>
         */
        public function getIterator(): \ArrayIterator {}
    }

    /**
     * One record of a Tree with its position: the id, the record, and the children and parent
     * looked up in the containing tree. Iterating gives the children.
     *
     * @template TRecord
     * @implements \ArrayAccess<string, mixed>
     * @implements \IteratorAggregate<int|string, SubTree<TRecord>>
     */
    class SubTree implements \ArrayAccess, \IteratorAggregate, \Countable
    {
        /** @var int|string */
        public $id;

        /** @var TRecord */
        public $record;

        /**
         * @param int|string $id
         * @param TRecord $record
         * @param Tree<TRecord> $containingTree
         */
        public function __construct($id, $record, Tree $containingTree) {}

        /**
         * @return array<int|string, SubTree<TRecord>>
         */
        public function children() {}

        /**
         * @return SubTree<TRecord>|null
         */
        public function parent() {}

        /**
         * @return \ArrayIterator<int|string, SubTree<TRecord>>
         */
        public function getIterator(): \ArrayIterator {}
    }

    class App
    {
        /**
         * @param mixed $contentType
         * @param mixed $contentId
         * @param mixed $with
         *
         * @return ($contentId is array ? Mvc\Entity\AbstractCollection<Mvc\Entity\Entity> : Mvc\Entity\Entity|null)
         */
        public function findByContentType($contentType, $contentId, $with = []) {}

        /**
         * The pather closure's result: the url, absolute or prefixed with the path type's base.
         *
         * @param mixed $externalPath
         * @param mixed $canonical
         *
         * @return string
         */
        public function applyExternalDataUrl($externalPath, $canonical = false) {}

        /**
         * @param mixed $externalPath
         * @param mixed $pathType
         *
         * @return string
         */
        public function applyExternalDataUrlPathed($externalPath, $pathType) {}
    }
}

namespace XF\AddOn {

    /** Declared so that Manager::getById() below validates: the validator cannot see the forum. */
    class AddOn
    {
        /**
         * The add-on's addon.json as read: the keys the file declares, which is where a key the
         * object's magic properties do not answer lives.
         *
         * @return array<string, mixed>
         */
        public function getJson() {}
    }

    class StepResult
    {
    }

    abstract class AbstractSetup
    {
        /**
         * XenForo documents each step method as `null|StepResult`, and a setup with a single
         * step, which is most of them, returns nothing - which PHPStan reports against that
         * docblock as a missing return. Only core reads the result.
         *
         * @param array<string, mixed> $stepParams
         *
         * @return StepResult|null|void
         */
        abstract public function install(array $stepParams = []);

        /**
         * @param array<string, mixed> $stepParams
         *
         * @return StepResult|null|void
         */
        abstract public function upgrade(array $stepParams = []);

        /**
         * @param array<string, mixed> $stepParams
         *
         * @return StepResult|null|void
         */
        abstract public function uninstall(array $stepParams = []);
    }

    class Manager
    {
        /**
         * Null when the forum has neither an installed record nor an addon.json for the id;
         * the loaded add-on class otherwise.
         *
         * @param mixed $addOnId
         *
         * @return AddOn|null
         */
        public function getById($addOnId) {}
    }
}

namespace XF\Mvc {

    use XF\Mvc\Reply\AbstractReply;
    use XF\Mvc\Reply\Error;
    use XF\Mvc\Reply\Exception;
    use XF\Mvc\Reply\Message;
    use XF\Mvc\Reply\Redirect;
    use XF\Mvc\Reply\View;

    abstract class Controller
    {
        /**
         * @param mixed $viewClass
         * @param mixed $templateName
         * @param array<mixed> $params
         *
         * @return View
         */
        public function view($viewClass = '', $templateName = '', array $params = []) {}

        /**
         * @param mixed $url
         * @param mixed $message
         * @param mixed $type
         *
         * @return Redirect
         */
        public function redirect($url, $message = null, $type = 'temporary') {}

        /**
         * @param mixed $url
         * @param mixed $message
         *
         * @return Redirect
         */
        public function redirectPermanently($url, $message = null) {}

        /**
         * @param string|\Stringable|array<string|\Stringable> $error
         * @param mixed $code
         *
         * @return Error
         */
        public function error($error, $code = 200) {}

        /**
         * @param mixed $message
         * @param mixed $code
         *
         * @return Message
         */
        public function message($message, $code = 200) {}

        /**
         * Corrected: XenForo documents a single message, and passes it to error(), which also
         * takes a list of them.
         *
         * @param string|\Stringable|array<string|\Stringable>|null $message
         *
         * @return AbstractReply
         */
        public function noPermission($message = null) {}

        /**
         * @return Exception
         */
        public function exception(AbstractReply $reply) {}
    }

    class Router
    {
        /**
         * @param mixed $link
         * @param mixed $data
         * @param array<mixed> $parameters
         * @param mixed $hash
         *
         * @return string
         */
        public function buildLink($link, $data = null, array $parameters = [], $hash = null) {}
    }
}

namespace XF\Mvc\Reply {

    abstract class AbstractReply
    {
        /**
         * @return array<string, mixed>
         */
        public function getJsonParams() {}
    }

    class Error extends AbstractReply
    {
    }

    class Exception extends \Exception
    {
    }

    class Message extends AbstractReply
    {
    }

    class Redirect extends AbstractReply
    {
        /**
         * @return string
         */
        public function getUrl() {}
    }

    class View extends AbstractReply
    {
        /**
         * @return array<string, mixed>
         */
        public function getParams() {}

        /**
         * @param mixed $key
         *
         * @return mixed
         */
        public function getParam($key) {}
    }
}

namespace XF\Mvc\Entity {

    abstract class Entity
    {
        /**
         * @param mixed $throw
         * @param mixed $newTransaction
         *
         * @return bool
         */
        final public function save($throw = true, $newTransaction = true) {}

        /**
         * @return array<string|int, \XF\Phrase|string>
         */
        public function getErrors() {}
    }

    class Structure
    {
        /** @var array<string, array<string, mixed>> */
        public $columns = [];

        /** @var array<string, array<string, mixed>> */
        public $relations = [];
    }

    class Manager
    {
        public const INSTANTIATE_ALLOW_INVALID = 0x1;
        public const INSTANTIATE_PROXIED = 0x2;

        /**
         * XenForo documents a bare ArrayCollection, which reads as a collection of Entity and so
         * cannot be returned where a typed collection is declared. The collection is of what it was
         * given, and the template binds nowhere but the parameter, so this is the second parameter
         * typed beyond XenForo's declaration: the body stores the array as the collection's
         * entities, and anything that is not one breaks the first method called on the result.
         *
         * @template T of Entity
         *
         * @param array<T> $entities
         *
         * @return ArrayCollection<T>
         */
        public function getBasicCollection(array $entities) {}

        /**
         * A collection of nothing, which passes wherever a typed collection is expected: the
         * short-circuit XenForo describes it for. The documented bare ArrayCollection does not.
         *
         * @return ArrayCollection<never>
         */
        public function getEmptyCollection() {}

        /**
         * Corrected: XenForo makes the result nullable when `$options` is an
         * `int-mask<INSTANTIATE_PROXIED>`, and that mask includes 0, so the default call read as
         * nullable and core's own `instantiateEntity(Draft::class)->user_id` would not pass. The
         * body returns null only under a non-zero option: always when proxied, and for a missing
         * key when an invalid entity is allowed.
         *
         * @template T of Entity
         *
         * @param class-string<T> $shortName
         * @param array<string, mixed> $values
         * @param array<string, mixed> $relations
         * @param int-mask-of<self::INSTANTIATE_*> $options
         *
         * @return ($options is 0 ? T : T|null)
         */
        public function instantiateEntity($shortName, array $values = [], array $relations = [], $options = 0) {}
    }

    /**
     * The class docblock is the real one, repeated: a stub class with a docblock replaces the
     * real class's, so leaving the generics out here would take them away.
     *
     * @template T of \XF\Mvc\Entity\Entity
     * @implements \IteratorAggregate<string|int, T>
     * @implements \ArrayAccess<string|int, T>
     */
    abstract class AbstractCollection implements \Countable, \IteratorAggregate, \ArrayAccess
    {
        /**
         * @return list<array-key>
         */
        public function keys() {}

        /**
         * Corrected: XenForo documents the callback as returning bool, and the body is
         * array_filter(), which keeps an entity for any truthy result.
         *
         * @param \Closure(T): mixed $callback
         *
         * @return AbstractCollection<T>
         */
        public function filter(\Closure $callback) {}

        /**
         * Corrected: XenForo writes `callable(T $e): int|string`, which PHPDoc reads as a callable
         * returning int beside a plain string, so every string-keyed grouping was reported.
         *
         * @param int|string|(callable(T $e): (int|string)) $grouper
         * @param int|string|(callable(T $e): (int|string))|null $childKeyFn
         *
         * @return array<int|string, array<int|string, T>>
         */
        public function groupBy($grouper, $childKeyFn = null) {}

        /**
         * getIterator() implements an interface method PHPStan stubs itself, and for a class
         * declared in a stub that ancestor stub outranks the real docblock, which every other
         * method here keeps. Restated from the real one, or iterating a collection yields mixed.
         *
         * @return \ArrayIterator<string|int, T>
         */
        public function getIterator(): \ArrayIterator {}
    }

    /**
     * Declared so that the manager's factories may name it, with the real docblock repeated for
     * the reason given on AbstractCollection.
     *
     * @template T of \XF\Mvc\Entity\Entity
     * @extends AbstractCollection<T>
     */
    class ArrayCollection extends AbstractCollection {}

    /**
     * The fluent methods return $this. XenForo documents order() as returning Finder, and the rest
     * not at all, so one chained call lost the entity type the finder was created with.
     *
     * @template T of \XF\Mvc\Entity\Entity
     * @implements \IteratorAggregate<string|int, T>
     */
    class Finder implements \IteratorAggregate
    {
        /**
         * As AbstractCollection::getIterator(): restated so the real docblock is not outranked.
         *
         * @return AbstractCollection<T>
         */
        public function getIterator() {}

        /**
         * @param mixed $condition
         * @param mixed $operator
         * @param mixed $value
         *
         * @return static
         */
        public function where($condition, $operator = null, $value = null) {}

        /**
         * @param mixed $sql
         *
         * @return static
         */
        public function whereSql($sql) {}

        /**
         * @param array<mixed> $conditionA
         * @param array<mixed>|null $conditionB
         *
         * @return static
         */
        public function whereOr(array $conditionA, ?array $conditionB = null) {}

        /**
         * @param mixed $id
         *
         * @return static
         */
        public function whereId($id) {}

        /**
         * @param array<mixed> $ids
         *
         * @return static
         */
        public function whereIds(array $ids) {}

        /**
         * @param mixed $condition
         * @param mixed $true
         * @param mixed $false
         *
         * @return static
         */
        public function whereIf($condition, $true, $false) {}

        /**
         * @return static
         */
        public function whereImpossible() {}

        /**
         * @param array<mixed> $options
         *
         * @return static
         */
        public function whereAddOnActive(array $options = []) {}

        /**
         * @return static
         */
        public function resetWhere() {}

        /**
         * @param mixed $field
         * @param string $direction
         *
         * @return static
         */
        public function order($field, $direction = 'ASC') {}

        /**
         * @param mixed $field
         * @param mixed $direction
         *
         * @return static
         */
        public function setDefaultOrder($field, $direction = 'ASC') {}

        /**
         * @return static
         */
        public function resetOrder() {}

        /**
         * @param mixed $name
         * @param mixed $mustExist
         *
         * @return static
         */
        public function with($name, $mustExist = false) {}

        /**
         * @param array<mixed> $condition
         *
         * @return static
         */
        public function withEntity(string $alias, array $condition) {}

        /**
         * @param mixed $limit
         * @param mixed $offset
         *
         * @return static
         */
        public function limit($limit, $offset = null) {}

        /**
         * @param mixed $page
         * @param mixed $perPage
         * @param mixed $thisPageExtra
         *
         * @return static
         */
        public function limitByPage($page, $perPage, $thisPageExtra = 0) {}

        /**
         * @param mixed $offset
         *
         * @return static
         */
        public function offset($offset) {}

        /**
         * @param mixed $keyedBy
         *
         * @return static
         */
        public function keyedBy($keyedBy) {}

        /**
         * @param mixed $pluckFrom
         * @param mixed $keyedBy
         *
         * @return static
         */
        public function pluckFrom($pluckFrom, $keyedBy = null) {}

        /**
         * @param mixed $hintType
         * @param mixed $indexName
         *
         * @return static
         */
        public function indexHint($hintType, $indexName) {}
    }
}

namespace XF\Entity {

    // Declared so that AbstractOption's row helpers may name it; no docblock, for the same reason
    // as User.
    class Option extends \XF\Mvc\Entity\Entity {}

    // Declared so that Purchase's docblock and ModeratorLog\AbstractHandler's signature may name
    // them; no docblock, as above.
    class PaymentProfile extends \XF\Mvc\Entity\Entity {}
    class ModeratorLog extends \XF\Mvc\Entity\Entity {}

    // No class docblock: XenForo's own @property lines survive a stub declaration that has none.
    class User extends \XF\Mvc\Entity\Entity
    {
        /**
         * @return bool
         */
        public function canFollowUser(User $user) {}

        /**
         * @param mixed $error
         *
         * @return bool
         */
        public function canViewFullProfile(&$error = null) {}

        /**
         * @param mixed $error
         *
         * @return bool
         */
        public function canViewBasicProfile(&$error = null) {}

        /**
         * @param mixed $permissionId
         *
         * @return bool
         */
        public function hasAdminPermission($permissionId) {}

        /**
         * The permission's value, not a flag: the permission cache holds a flag permission as a
         * bool and an integer permission such as maxMentionedUsers as its int, and these return
         * whichever the name has, false when it is unknown.
         *
         * @param mixed $group
         * @param mixed $permission
         *
         * @return bool|int
         */
        public function hasPermission($group, $permission) {}

        /**
         * @param mixed $contentType
         * @param mixed $contentId
         * @param mixed $permission
         *
         * @return bool|int
         */
        public function hasContentPermission($contentType, $contentId, $permission) {}

        /**
         * @param mixed $contentId
         * @param mixed $permission
         *
         * @return bool|int
         */
        public function hasNodePermission($contentId, $permission) {}
    }

    class Node extends \XF\Mvc\Entity\Entity
    {
        /**
         * The crumbs the method body builds, one array per ancestor and optionally the node itself.
         *
         * @param mixed $includeSelf
         * @param mixed $linkType
         *
         * @return list<array{value: string, href: string, node_id: int}>
         */
        public function getBreadcrumbs($includeSelf = true, $linkType = 'public') {}

        /**
         * The node type's own extras, or nothing: string keys in every implementation.
         *
         * @return array<string, mixed>
         */
        public function getNodeListExtras() {}
    }
}

namespace XF\Repository {

    /**
     * No parent named: PHPStan validates a stub against the classes in stubs and the autoloader,
     * not the scanned forum, so the real Repository is unknown here. Node above names Entity
     * because the collection's bound needs it, and Entity is declared in this file.
     */
    class NodeRepository
    {
        /**
         * A node finder's fetch(); createNodeTree() below builds the typed tree from it.
         *
         * @param mixed $with
         *
         * @return \XF\Mvc\Entity\AbstractCollection<\XF\Entity\Node>
         */
        public function getFullNodeList(?\XF\Entity\Node $withinNode = null, $with = null) {}

        /**
         * The collection it was given, filtered, so what came in is what goes out.
         *
         * @template T of \XF\Mvc\Entity\Entity
         *
         * @param \XF\Mvc\Entity\AbstractCollection<T> $nodes
         *
         * @return \XF\Mvc\Entity\AbstractCollection<T>
         */
        public function filterViewable(\XF\Mvc\Entity\AbstractCollection $nodes) {}

        /**
         * A Tree over the nodes given, keyed by node id and parented by parent_node_id.
         *
         * @param mixed $nodes
         * @param mixed $rootId
         *
         * @return \XF\Tree<\XF\Entity\Node>
         */
        public function createNodeTree($nodes, $rootId = 0) {}

        /**
         * The extras merged over their defaults, with the children's counts folded in: the
         * defaults are string-keyed and getNodeListExtras() is too, so the merge is.
         *
         * @param mixed[] $extras
         * @param mixed[] $childExtras
         *
         * @return array<string, mixed>
         */
        public function mergeNodeListExtras(array $extras, array $childExtras) {}
    }

    class ActivityLogRepository
    {
        /**
         * Corrected: XenForo documents a list of metric maps and its own handlers pass one map,
         * which is what the handler's log() documents too.
         *
         * @param array<string, int> $values
         */
        public function log(\XF\Mvc\Entity\Entity $content, int $logDate, array $values, bool $increment = true): void {}
    }

    class AttachmentRepository
    {
        /**
         * Corrected: XenForo writes `AbstractCollection|Entity[]`, which PHPStan reads as a
         * collection only; the body iterates whatever it is given.
         *
         * @param iterable<\XF\Mvc\Entity\Entity> $content
         * @param mixed $contentType
         * @param mixed $countKey
         * @param mixed $relationKey
         *
         * @return mixed
         */
        public function addAttachmentsToContent($content, $contentType, $countKey = 'attach_count', $relationKey = 'Attachments') {}
    }
}

namespace XF\Widget {

    class WidgetRenderer {}

    abstract class AbstractWidget
    {
        /**
         * Corrected: XenForo documents string|null, and every core widget returns
         * $this->renderer(), so an add-on's did too and was reported as incompatible.
         *
         * @return string|WidgetRenderer|null
         */
        abstract public function render();
    }
}

namespace XF\Purchasable {

    /**
     * Restated in full, because a stub's class docblock replaces the real one. Corrected in one
     * line: purchasableId is documented string, and core's own purchasable assigns an entity id.
     *
     * @property string $title
     * @property string $description
     * @property float $cost
     * @property string $currency
     * @property bool $recurring
     * @property int $lengthAmount
     * @property string $lengthUnit
     * @property \XF\Entity\User $purchaser
     * @property \XF\Entity\PaymentProfile $paymentProfile
     * @property string $purchasableTypeId
     * @property string|int $purchasableId
     * @property string $purchasableTitle
     * @property array<string, mixed> $extraData
     * @property string $cancelUrl
     * @property string $returnUrl
     * @property string $updateUrl
     * @property string $requestKey
     */
    class Purchase {}
}

namespace XF\ActivityLog {

    /**
     * @template T of \XF\Mvc\Entity\Entity
     */
    abstract class AbstractHandler
    {
        /**
         * Corrected: XenForo documents a map, and the body appends the cut-off date and binds
         * them positionally.
         *
         * @param array<mixed> $params
         *
         * @return array<string, string|int>
         */
        protected function getReplyMetricsSimple(string $table, string $dateColumn, string $where, array $params): array {}

        /**
         * Corrected: XenForo documents the handler's own entity, and its thread handler passes
         * the first post, so a container handler's override was reported.
         *
         * @return array<string, string|int>
         */
        protected function getReactionMetrics(\XF\Mvc\Entity\Entity $content): array {}
    }
}

namespace XF\Stats {

    abstract class AbstractHandler
    {
        /**
         * Corrected: XenForo documents an int, and its attachment handler returns round(..., 2).
