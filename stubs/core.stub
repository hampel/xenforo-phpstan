        /**
         * @param array<string, mixed> $htmlParams
         * @param array<int|string, mixed> $choices
         * @param mixed $value
         *
         * @return string
         */
        protected static function getRadioRow(\XF\Entity\Option $option, array $htmlParams, array $choices, $value = null) {}

        /**
         * @param array<string, mixed> $htmlParams
