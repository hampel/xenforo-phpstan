namespace XF\Http {

    class Request
    {
        /**
         * @param mixed $key
         * @param mixed $type
         * @param mixed $default
         *
         * @return ($key is array ? array<string, mixed> : mixed)
         */
        public function filter($key, $type = null, $default = null) {}

        /**
         * getServer('HTTP_USER_AGENT') with its default fallback, so false when the request sent
         * no agent at all - which a string column set from it does not survive.
         *
         * @return string|false
         */
        public function getUserAgent() {}

        /**
         * The base url up to its last slash, or '/'.
         *
         * @return string
         */
        public function getBasePath() {}

        /**
         * @return string
         */
        public function getFullBasePath() {}
    }
}

namespace XF\Util {

    class File
    {
        /**
         * @return string
         */
        public static function getTempDir() {}

        /**
         * tempnam(), which is false when the temp directory cannot be written; XenForo does not
         * check, so a caller that does is ahead of it.
