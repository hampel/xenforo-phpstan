namespace XF\Db {

    /** Declared so that query()'s return type below validates: the validator cannot see the forum. */
    abstract class AbstractStatement
    {
    }

    abstract class AbstractAdapter
    {
        /**
         * XenForo documents $params as an array, and its own calls pass a scalar everywhere:
         * AbstractStatement's constructor wraps one in an array. The documented type reports
         * core's own idiom at level 5. Corrected rather than transcribed, the first of the
         * corrections marked so in this file.
         *
         * @param mixed $query
         * @param array<mixed>|scalar|null $params
         *
         * @return AbstractStatement
         */
        public function query($query, $params = []) {}

        /**
         * @param mixed $data
         * @param mixed $type
         *
         * @return string
         */
        public function quote($data, $type = null) {}

        /**
         * @param mixed $query
         * @param mixed $params
         * @param mixed $column
         *
         * @return list<mixed>
         */
        public function fetchAllColumn($query, $params = [], $column = 0) {}

        /**
         * @param mixed $query
         * @param mixed $params
         *
         * @return array<string, mixed>|false
         */
        public function fetchRow($query, $params = []) {}

        /**
         * @param mixed $query
         * @param mixed $params
         *
         * @return list<array<string, mixed>>
         */
        public function fetchAll($query, $params = []) {}

        /**
         * @param mixed $query
         * @param mixed $params
         *
         * @return array<int|string, mixed>
         */
        public function fetchPairs($query, $params = []) {}

        /**
         * Rows keyed by the named column's value, or by a counter where a row lacks it.
         *
         * @param mixed $query
         * @param mixed $key
         * @param mixed $params
         *
         * @return array<int|string, array<string, mixed>>
         */
        public function fetchAllKeyed($query, $key, $params = []) {}

        /**
         * @return int
         */
        public function getQueryCount() {}
    }
}

