# The configuration an add-on needs to be analysed against the XenForo install it sits in.
# Include it from the add-on's own phpstan.neon:
#
#     includes:
#         - vendor/hampel/xenforo-phpstan/extension.neon
#
# Everything here is a property of XenForo, identical for every add-on. The add-on's own
# file supplies what is its own: paths, level, and the exclusions for its vendor/, _output/,
# _releases/ and _data/ directories - see README.md.
parameters:
    xenforo:
        # The forum root. An add-on lives at <root>/src/addons/<Vendor>/<AddOn>, so from the
        # add-on's own directory - where PHPStan is run from - the forum is four levels up.
        # Override it for an add-on analysed from anywhere else:
        #
        #     parameters:
        #         xenforo:
        #             root: /path/to/forum
        root: %currentWorkingDirectory%/../../../..

        # Where `vendor/bin/xenforo-phpstan generate` wrote its files. Per forum rather than
        # per add-on, because what they describe - the classes XenForo aliases and the class
        # extensions every installed add-on registers - is a property of the install.
        generated: %xenforo.root%/internal_data/phpstan

    # The add-on is analysed; XenForo is only scanned for symbols. Other add-ons are scanned
    # too, because add-ons reference each other - but not their vendor/ directories, where
    # an older copy of a shared dependency would otherwise shadow the add-on's own. PHPStan
    # consults a scanned directory before the Composer autoloader.
    scanDirectories:
        - %xenforo.root%/src/XF
        - %xenforo.root%/src/vendor
        - %xenforo.root%/src/addons

    excludePaths:
        analyseAndScan:
            # The trailing /* is load-bearing: PHPStan matches an exclusion pattern against
            # each file with fnmatch(), so a pattern ending in /vendor matches only the
            # directory entry and nothing inside it.
            - %xenforo.root%/src/addons/*/*/vendor/*
            # A release build copies the add-on under _build/upload/, present while the build
            # runs and after one that failed. Scanned, it declares every class of that add-on
            # twice; a file deleted while PHPStan reads it aborts the run.
            - %xenforo.root%/src/addons/*/*/_build/*

    scanFiles:
        # \XF itself, and utf8_substr() and friends, which XenForo require()s rather than
        # autoloads.
        - %xenforo.root%/src/XF.php
        - %xenforo.root%/src/utf8.php

        # Generated by `vendor/bin/xenforo-phpstan generate`: the legacy class names XenForo
        # 2.3 aliases at runtime, and the XFCP_ parent of every class extension in the install.
        - %xenforo.generated%/legacy-aliases.stub.php
        - %xenforo.generated%/class-extensions.stub.php

    stubFiles:
        # XenForo documents the index name of the schema builder's key methods as `null`;
        # every Setup.php passes a string.
        - stubs/db-schema.stub

        # Return types XenForo leaves undeclared on the methods every add-on calls - the
        # controller's reply helpers, the finder's fluent methods, the router, phrases, the
        # database adapter - read from the method bodies of 2.3.13. What level 7 and above
        # report without them is every result being mixed.
        - stubs/core.stub

    ignoreErrors:
        # XenForo 2.3 annotates every container shortcut with @param class-string<T>, and the
        # implementation accepts the short Vendor\AddOn:Name identifier as well - the form most
        # add-on code uses, and the only one that still works for a renamed core class while
        # the add-on supports 2.2. So the annotation is narrower than the method, and at level
        # 5 every identifier is reported against it. The extensions below type what the call
        # returns; this stops the argument being reported. Scoped to those methods and to a
        # string argument: an int or an array is still reported. A stub cannot do this -
        # PHPStan simplifies class-string<T>|string to string, which loses T.
        -
            message: '#^Parameter \#1 \$\w+ of (?:static )?method XF(?:\\[\w\\]+)?::(?:find|findOne|findCached|finder|getFinder|repository|getRepository|service|data|plugin|create|instantiateEntity|getBehavior|assertRecordExists|assertRecordExistsByUnique|assertViewableRecord|assertViewableApiRecord|job|searcher|filterer|auth|helper|validator|criteria|notifier)\(\) expects class-string<[^>]+>, (?:non-falsy-string|non-empty-string|literal-string|string|\x27[^\x27]*\x27) given\.$#'
            identifier: argument.type
            # An add-on that passes ::class everywhere has nothing for this to match.
            reportUnmatched: false
        # The same calls at level 6, where PHPStan also reports that the identifier does not
        # bind T. The return type is supplied by the extensions below regardless.
        -
            message: '#^Unable to resolve the template type T in call to (?:(?:static )?method )+XF(?:\\[\w\\]+)?::(?:find|findOne|findCached|finder|getFinder|repository|getRepository|service|data|plugin|create|instantiateEntity|getBehavior|assertRecordExists|assertRecordExistsByUnique|assertViewableRecord|assertViewableApiRecord|job|searcher|filterer|auth|helper|validator|criteria|notifier)\(\)$#'
            identifier: argument.templateType
            reportUnmatched: false

parametersSchema:
    xenforo: structure([
        root: string()
        generated: string()
    ])

services:
    -
        class: Hampel\XenForo\PHPStan\Classes
        arguments:
            file: %xenforo.generated%/classes.php
            root: %xenforo.root%

    # Methods a class extension adds to a core class, reachable through the core type.
    -
        class: Hampel\XenForo\PHPStan\Reflection\ClassExtensionMethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension

    # The properties XF\AddOn\AddOn answers by magic: its own nine keys, then the installed
    # entity's columns. Typed one by one, so a mistyped key is still reported.
    -
        class: Hampel\XenForo\PHPStan\Reflection\AddOnPropertiesExtension
        tags:
            - phpstan.broker.propertiesClassReflectionExtension

    # Container shortcuts given the short Vendor\AddOn:Name identifier. XenForo 2.3 already
    # types them for a class-string argument; these resolve the identifier form, one service
    # per class that declares the shortcuts.
    -
        class: Hampel\XenForo\PHPStan\Type\ShortcutTypes
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\App
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Controller
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Api\Controller\AbstractController
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Entity\Manager
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Entity\Repository
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Entity\Entity
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Service\AbstractService
    -
        class: Hampel\XenForo\PHPStan\Type\ContainerShortcutExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Widget\AbstractWidget
    -
        class: Hampel\XenForo\PHPStan\Type\StaticContainerShortcutExtension
        tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]

    # A relation by name: getRelation('Auth') and getRelationOrDefault('Auth') typed from the
    # receiver's own @property-read for that name, which every entity and extension declares.
    -
        class: Hampel\XenForo\PHPStan\Type\RelationReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Entity\Entity

    # Every controller action returns a reply, through $this-> and parent:: alike; an action
    # that declares its own return type is left alone.
    -
        class: Hampel\XenForo\PHPStan\Type\ActionReplyExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
        arguments:
            className: XF\Mvc\Controller

    # Request input, typed from the filter string: filter('id', 'uint') is an int and an array
    # of filters is an array shape, as XF\InputFilterer casts them. One service per class.
    -
        class: Hampel\XenForo\PHPStan\Type\FilterReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Mvc\Controller
    -
        class: Hampel\XenForo\PHPStan\Type\FilterReturnTypeExtension
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
        arguments:
            className: XF\Http\Request
